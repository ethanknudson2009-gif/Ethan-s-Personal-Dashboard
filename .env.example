# Copy this file to .env.local (which git ignores) and fill in the values.
# Step-by-step: docs/setup/01-supabase-and-vercel.md
# Never put real values in THIS file: it is committed to GitHub.

# Supabase → Project Settings → Data API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase → Project Settings → API Keys → Publishable key (starts with sb_publishable_)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
